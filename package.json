{
  "name": "guardiao-zero-pro",
  "version": "3.1.3",
  "description": "Proteção local multifator contra plataformas de apostas, anúncios e rastreadores.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs --firefox",
    "build:firefox": "node tools/build.mjs --firefox",
    "build:chromium": "node tools/build.mjs --chromium",
    "build:rules": "node tools/build-rules.mjs",
    "build:icons": "node tools/make-icons.mjs",
    "build:shots": "node tools/make-listing-shots.mjs",
    "build:chart": "node tools/make-benchmark-chart.mjs",
    "clean": "node tools/build.mjs --clean",
    "lint": "node tools/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "benchmark": "node --expose-gc tools/benchmark.mjs",
    "bench:engine": "node tools/engine-benchmark.mjs",
    "test:real": "node tools/real-world-evaluation.mjs",
    "package:amo": "node tools/package-amo.mjs",
    "smoke:firefox": "node tools/smoke-firefox.mjs",
    "check": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "webextension",
    "firefox",
    "chromium",
    "privacy",
    "adblock",
    "gambling-blocker",
    "anti-phishing"
  ],
  "author": "Guardião Zero Team",
  "license": "MIT",
  "homepage": "https://github.com/Heazts/guardiao-zero",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "web-ext": "10.6.0"
  }
}
